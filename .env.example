# Copy this file to .env and adjust the values. .env is never committed.

# PostgreSQL (Docker Compose)
POSTGRES_DB=factorydeck
POSTGRES_USER=factorydeck
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

# Any PostgreSQL 16+ database works: point this at your own server to skip Docker.
DATABASE_URL=postgres://factorydeck:change-me@localhost:5434/factorydeck

# Port of the FactoryDeck server, always bound to 127.0.0.1.
FACTORYDECK_PORT=4317

# Seconds between two ingestions of the session logs while the server runs (a whole number, at least 1).
FACTORYDECK_INGEST_INTERVAL_SECONDS=10

# Minutes between two collections of issues and pull or merge requests from each project's git host
# while the server runs (a whole number, at least 1).
FACTORYDECK_COLLECT_INTERVAL_MINUTES=5

# Minutes without a new record after which a session shows as inactive (a whole number, at least 1).
FACTORYDECK_INACTIVE_AFTER_MINUTES=30

# Workflow configuration (roles and work items). Empty means factorydeck.yml at the repository root;
# a leading ~ is the home folder, and a relative path starts from the repository root.
FACTORYDECK_CONFIG=
