{
  "name": "factorydeck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first dashboard for an AI agent software factory: tokens, cost per issue and per role, review rounds and frictions.",
  "license": "MIT",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "fix": "pnpm format && oxlint --type-aware --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
