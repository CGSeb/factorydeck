    {
      "op": "alter",
      "key": "views\u0000[\"public\",\"project_git_host\"]",
      "set": {
        "definition": "select p.slug as project, g.remote, g.git_host, g.repository, g.synced_from, g.error, g.error_git_host, g.stage_labels, g.auto_merge, g.bug_label, g.history_read, g.fix_read, g.state_events_read, g.body_closes_read from git_host_project g join project p on p.remote = g.remote"
      }
    },
    {
      "op": "alter",
      "key": "views\u0000[\"public\",\"project_issue\"]",
      "set": {
        "definition": "select p.slug as project, i.number, i.title, i.state, i.labels, i.url, i.created_at, i.closed_at, i.updated_at, i.reopened, i.state_events, i.needs_spec from git_host_issue i join project p on p.remote = i.remote"
      }
    },
    {
      "op": "alter",
      "key": "views\u0000[\"public\",\"project_request\"]",
      "set": {
        "definition": "select p.slug as project, q.number, q.title, q.state, q.draft, q.head_branch, q.url, q.created_at, q.merged_at, q.closed_at, q.updated_at, q.closes, q.checks, q.report, q.reports from git_host_request q join project p on p.remote = q.remote"
      }
    }
