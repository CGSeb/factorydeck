        "definition": "select h.project, h.root, g.git_host, g.repository, g.synced_from, g.error, g.error_git_host, g.stage_labels, g.auto_merge, g.bug_label, g.history_read, g.fix_read, g.state_events_read, g.body_closes_read from git_host_project g join (select distinct on (p.slug) p.slug as project, g.project as root from git_host_project g join root_remote r on r.root = g.project join project p on p.remote = r.remote order by p.slug, g.synced_from desc nulls last, g.project) h on h.root = g.project",
